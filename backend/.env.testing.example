# Copy to backend/.env.testing if needed.
# Do not set DB_PASSWORD here; inherit it from the local environment.
# phpunit.xml forces DB_DATABASE=bluepos_test and must never use bluepos_dev.

APP_ENV=testing
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bluepos_test
DB_USERNAME=postgres
